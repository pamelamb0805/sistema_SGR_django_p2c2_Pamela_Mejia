DEBUG=True  # Solo desarrollo local; en AWS configurar DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=mysql
DB_NAME=bd_name_example
DB_USER=example_username
DB_PASSWORD=example_password
DB_HOST=127.0.0.1
DB_PORT=3306
# la clave debe ir en privado en el archivo env --> Pm
SECRET_KEY=replace_with_a_long_random_secret
# Correo SMTP para recuperación real (dejar EMAIL_HOST vacío usa consola local)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Producción HTTPS
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
REDIS_URL=  # En desarrollo puede quedar vacío; en producción configurar Redis

# Recuperación de contraseña (valores iniciales de ANEXO A)
SGR_RESET_CODE_LIFETIME_SECONDS=600
SGR_RESET_CODE_RESEND_SECONDS=45
SGR_RESET_CODE_MAX_ATTEMPTS=5
SGR_RESET_CODE_MAX_RESENDS=3
